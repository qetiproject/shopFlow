{
  "name": "shopFlow",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:analyze": "ng build --configuration=analyze",
    "analyze": "npm run build:analyze && npx source-map-explorer dist/shopFlow/browser/*.js --html dist/shopFlow/bundle-stats.html --no-open",
    "watch": "ng build --watch --configuration development",
    "build:ssr": "ng build --configuration=production",
    "serve:ssr:ssr": "node dist/shopFlow/server/server.mjs",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.3",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.0",
    "@ngrx/effects": "^21.0.1",
    "@ngrx/router-store": "^21.0.1",
    "@ngrx/signals": "^21.0.1",
    "@ngrx/store": "^21.0.1",
    "@ngrx/store-devtools": "^21.0.1",
    "express": "^5.1.0",
    "ngx-stripe": "^21.8.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "21.2.0",
    "baseline-browser-mapping": "^2.9.11",
    "eslint": "^10.0.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.56.1",
    "source-map-explorer": "^2.5.3"
  }
}
